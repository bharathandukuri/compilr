# ==============================================================================
# COMPILR - OPTIONAL CONFIGURATION (.env)
# ==============================================================================
# ALL variables in this file are completely OPTIONAL.
# Compilr works out-of-the-box with safe, production-ready defaults if this file
# is empty or not present at all.
#
# To customize any setting, uncomment the line (remove the leading '#') and edit.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RESOURCE & INPUT LIMITS
# ------------------------------------------------------------------------------

# Maximum source code size accepted per execution (in bytes).
# Prevents users from uploading massive files that consume excess server memory.
# Default: 262144 (256 KB)
# MAX_SOURCE_SIZE_BYTES=262144

# Maximum standard input (stdin) size accepted per execution (in bytes).
# Default: 262144 (256 KB)
# MAX_STDIN_SIZE_BYTES=262144

# Maximum program output (stdout + stderr) captured by the server (in bytes).
# Prevents runaway infinite loops (e.g. while(true) print('x')) from flooding the system.
# Default: 1048576 (1 MB)
# MAX_OUTPUT_SIZE_BYTES=1048576

# Default memory limit per sandbox execution container (in kilobytes).
# Default: 262144 (256 MB)
# DEFAULT_MEMORY_LIMIT_KB=262144


# ------------------------------------------------------------------------------
# 2. EXECUTION TIME LIMITS
# ------------------------------------------------------------------------------

# Default time limit for code execution (in milliseconds).
# If the user code takes longer than this, it is terminated with TIME_LIMIT_EXCEEDED.
# 1000 ms = 1 second.
# Default: 5000 (5 seconds)
# DEFAULT_TIMEOUT_MS=5000

# Maximum time limit a user is allowed to request (in milliseconds).
# Users cannot ask for more time than this threshold.
# Default: 15000 (15 seconds)
# MAX_TIMEOUT_MS=15000

# Minimum time limit a user is allowed to request (in milliseconds).
# Default: 100 (100 milliseconds)
# MIN_TIMEOUT_MS=100


# ------------------------------------------------------------------------------
# 3. RATE LIMITING (ABUSE & BOT PROTECTION)
# ------------------------------------------------------------------------------

# Enable or disable per-client rate limiting.
# Protects your API from being spammed or overwhelmed by automated scripts.
# Values: true | false
# Default: true
# RATE_LIMIT_ENABLED=true

# Maximum number of execution requests allowed per client within the time window.
# Default: 15 requests
# RATE_LIMIT_MAX_REQUESTS=15

# Duration of the sliding time window for rate limiting (in seconds).
# For example: 15 requests per 60 seconds.
# Default: 60 (1 minute)
# RATE_LIMIT_WINDOW_SECONDS=60


# ------------------------------------------------------------------------------
# 4. CONCURRENCY & QUEUE PROTECTION
# ------------------------------------------------------------------------------

# Maximum number of execution containers running simultaneously across all languages.
# Adjust this based on your server resources:
#   - 1-2 vCPU server (e.g. AWS t3.small, 2GB RAM):  8 - 12
#   - 4+ vCPU server (e.g. 8GB+ RAM):                16 - 32
# Default: 12
# MAX_CONCURRENT_JOBS=12

# Maximum time (in milliseconds) a request will wait in the queue before timing out
# if all execution slots are currently busy.
# Default: 10000 (10 seconds)
# MAX_QUEUE_WAIT_TIMEOUT_MS=10000


# ------------------------------------------------------------------------------
# 5. SERVER LOGGING
# ------------------------------------------------------------------------------

# Log verbosity level for the Compilr server.
# Options: INFO | WARN | ERROR | DEBUG
# Default: INFO
# LOG_LEVEL=INFO
