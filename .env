# ==============================================================================
# Compilr Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Host Exposed Ports
# ------------------------------------------------------------------------------
CLIENT_PORT=6990
SERVER_PORT=6991
REDIS_PORT=6992

# ------------------------------------------------------------------------------
# Redis Service Configuration
# ------------------------------------------------------------------------------
REDIS_PASSWORD=stacked_redis_secret
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=stacked_redis_secret

# ------------------------------------------------------------------------------
# Docker Execution Engine Configuration
# ------------------------------------------------------------------------------
COMPILR_EXECUTION_DOCKER_HOST=unix:///var/run/docker.sock
COMPILR_EXECUTION_DOCKER_ENABLED=true

# ------------------------------------------------------------------------------
# Sandbox & Compiler Resource Limits
# ------------------------------------------------------------------------------
COMPILR_COMPILER_DEFAULT_TIME_LIMIT_MS=5000
COMPILR_COMPILER_MAX_TIME_LIMIT_MS=15000
COMPILR_COMPILER_MIN_TIME_LIMIT_MS=100
COMPILR_COMPILER_DEFAULT_MEMORY_LIMIT_KB=262144
COMPILR_COMPILER_MAX_SOURCE_SIZE_BYTES=262144
COMPILR_COMPILER_MAX_STDIN_SIZE_BYTES=262144
COMPILR_COMPILER_MAX_OUTPUT_SIZE_BYTES=1048576

# ------------------------------------------------------------------------------
# Rate Limiting & Queue Protection
# ------------------------------------------------------------------------------
COMPILR_PROTECTION_RATE_LIMIT_ENABLED=true
COMPILR_PROTECTION_RATE_LIMIT_MAX_REQUESTS=15
COMPILR_PROTECTION_RATE_LIMIT_WINDOW_SECONDS=60
COMPILR_PROTECTION_QUEUE_DEFAULT_PROCESSING_CAPACITY=3
COMPILR_PROTECTION_QUEUE_DEFAULT_QUEUE_CAPACITY=10
COMPILR_PROTECTION_QUEUE_GLOBAL_MAX_PROCESSING=12
COMPILR_PROTECTION_QUEUE_GLOBAL_MAX_QUEUED=50

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Client Frontend
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
