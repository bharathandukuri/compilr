# ==============================================================================
# COMPILR - DOCKER-IN-DOCKER (DinD) ENVIRONMENT CONFIGURATION
# ==============================================================================
# In DinD mode, the entire stack (Client, Server, Redis, and Sandboxes) runs
# inside a single container.
#
# • Host ports are chosen when starting the container:
#     docker run -d --privileged -p 6990:6990 --env-file .env compilr:latest
#
# • ALL variables below are 100% OPTIONAL.
# • Safe production defaults are used if this file is empty or omitted.
# • To override any setting, uncomment the line (remove '#') and edit the value.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RESOURCE & INPUT LIMITS
# ------------------------------------------------------------------------------

# Maximum source code size accepted per execution (in bytes).
# Default: 262144 (256 KB)
# MAX_SOURCE_SIZE_BYTES=262144

# Maximum standard input (stdin) size accepted per execution (in bytes).
# Default: 262144 (256 KB)
# MAX_STDIN_SIZE_BYTES=262144

# Maximum program output (stdout + stderr) captured by the server (in bytes).
# Default: 1048576 (1 MB)
# MAX_OUTPUT_SIZE_BYTES=1048576

# Default memory limit per sandbox execution container (in kilobytes).
# Default: 262144 (256 MB)
# DEFAULT_MEMORY_LIMIT_KB=262144


# ------------------------------------------------------------------------------
# 2. EXECUTION TIME LIMITS
# ------------------------------------------------------------------------------

# Default time limit for code execution (in milliseconds).
# 1000 ms = 1 second.
# Default: 5000 (5 seconds)
# DEFAULT_TIMEOUT_MS=5000

# Maximum time limit a user is allowed to request (in milliseconds).
# Default: 15000 (15 seconds)
# MAX_TIMEOUT_MS=15000

# Minimum time limit a user is allowed to request (in milliseconds).
# Default: 100 (100 milliseconds)
# MIN_TIMEOUT_MS=100


# ------------------------------------------------------------------------------
# 3. RATE LIMITING (ABUSE & BOT PROTECTION)
# ------------------------------------------------------------------------------

# Enable or disable sliding-window rate limiting per client.
# Values: true | false
# Default: true
# RATE_LIMIT_ENABLED=true

# Maximum execution requests allowed per client within the window.
# Default: 15 requests
# RATE_LIMIT_MAX_REQUESTS=15

# Sliding time window duration (in seconds).
# Default: 60 (1 minute)
# RATE_LIMIT_WINDOW_SECONDS=60


# ------------------------------------------------------------------------------
# 4. CONCURRENCY & QUEUE
# ------------------------------------------------------------------------------

# Maximum concurrent execution sandboxes running simultaneously across all languages.
# Adjust for your host RAM/CPU:
#   - 1-2 vCPU, 2GB RAM:  8 - 12
#   - 4+ vCPU, 8GB+ RAM:  16 - 32
# Default: 12
# MAX_CONCURRENT_JOBS=12

# Maximum time (in milliseconds) a request will wait in queue if all slots are busy.
# Default: 10000 (10 seconds)
# MAX_QUEUE_WAIT_TIMEOUT_MS=10000


# ------------------------------------------------------------------------------
# 5. SERVER LOGGING
# ------------------------------------------------------------------------------

# Server log verbosity level (INFO | WARN | ERROR | DEBUG).
# Default: INFO
# LOG_LEVEL=INFO
